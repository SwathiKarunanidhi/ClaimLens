# Defaults work without an API key. Copy to .env to change settings.
ASSESSMENT_MODE=demo
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
PORT=3001
HOST=127.0.0.1
# Set true after building to serve React and the API from one backend URL.
SERVE_FRONTEND=false
FRONTEND_ORIGIN=http://localhost:3000
# Runtime database is always in memory. This URL is for Prisma schema tooling only.
DATABASE_URL=file:./dev.db
